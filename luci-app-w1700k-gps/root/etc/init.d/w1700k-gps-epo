#!/bin/sh /etc/rc.common
# Satellite prediction daemon for the W1700K GPS; only runs when enabled in /etc/config/w1700k_gps.

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get w1700k_gps.epo.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/w1700k-gps-epo run
	procd_set_param respawn 3600 60 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger w1700k_gps
}
